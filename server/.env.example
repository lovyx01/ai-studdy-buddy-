# ============================================================
# AI STUDY BUDDY - SERVER CONFIGURATION
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# Port the server listens on. Default 8080.
PORT=8080

# ------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------
# JWT secret used to sign auth tokens. Use a LONG random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime. Default 7d.
JWT_EXPIRES=7d

# ------------------------------------------------------------------
# AI INTEGRATION  <--  THIS IS THE MAIN THING YOU MUST SET
# ------------------------------------------------------------------
# The AI tutor uses an OpenAI-compatible Chat Completions API.
# This works out-of-the-box with OpenAI, OpenRouter, Groq, Together,
# Mistral, etc. All you need is an API key + base URL.
#
# STEP 1: Create a key at https://platform.openai.com/api-keys
# STEP 2: Put it in the line below (no quotes).
# STEP 3: Restart the server. That's it.
#
# This key NEVER leaves the server - it is never sent to the phone.
OPENAI_API_KEY=

# Base URL. Defaults to OpenAI. Swap for other providers, e.g.:
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   Together:   https://api.together.xyz/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name. Default gpt-4o-mini (cheap + smart).
# Others: gpt-4o, gpt-4o-mini, llama-3.3-70b-versatile (Groq), etc.
OPENAI_MODEL=gpt-4o-mini

# Max tokens for AI responses.
AI_MAX_TOKENS=1200

# ------------------------------------------------------------------
# FREEMIUM LIMITS  (daily free-plan quotas)
# ------------------------------------------------------------------
FREE_DAILY_CHAT=15        # AI chat messages per day (free plan)
FREE_MONTHLY_QUIZZES=3    # Quizzes generated per month (free plan)
FREE_MAX_MATERIALS=5      # Total uploaded study materials (free plan)
FREE_FLASHCARD_SETS=2     # Flashcard sets (free plan)
